<UserControl
    x:Class="ImageZoomRectROI.ZoomImage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ImageZoomRectROI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border
        BorderBrush="Red"
        BorderThickness="1"
        
        ClipToBounds="True">
        <Grid
            Background="Transparent"
            x:Name="ImageContainer"
            LostMouseCapture="ImageContainer_LostMouseCapture"
            MouseLeftButtonDown="ImageContainer_MouseDown"
            MouseMove="ImageContainer_MouseMove"
            MouseUp="ImageContainer_MouseUp"
            MouseWheel="ImageContainer_MouseWheel">
            <Image x:Name="myimage" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PART_ScaleTransform" />
                        <TranslateTransform x:Name="PART_TranslateTransform" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Grid>
    </Border>
</UserControl>
