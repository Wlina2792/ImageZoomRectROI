<Window
    x:Class="YoloLabelTool.UI.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:material="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:wiconbutton="clr-namespace:Wlina.Components.IconButton"
    xmlns:rectroi="clr-namespace:Wlina.Components.RectRoiShape"
    xmlns:textedit="clr-namespace:Wlina.Components.TextEdit"
    xmlns:wcard="clr-namespace:Wlina.Components.WCard"
    xmlns:zoomimage="clr-namespace:Wlina.Components.ZoomImage"
    xmlns:converts="clr-namespace:YoloLabelTool.UI.Converts"
    xmlns:vm="clr-namespace:YoloLabelTool.UI.ViewModels.Windows"
    Title="MainWindow"
    Width="1600"
    Height="900"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Background>
        <ImageBrush ImageSource="/UI/Resources/Image/gradient-mesh-dark.jpg" />
    </Window.Background>
    <Window.Resources>
        <converts:HashColorConvert x:Key="HashColorConvert" />
        <converts:FIlePathToFileNameConvert x:Key="FIlePathToFileNameConvert" />
        <converts:point_convert x:Key="point_convert" />
        <converts:LabelNameConvert x:Key="LabelNameConvert" />
        <converts:FindTypeIdConvert x:Key="FindTypeIdConvert"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    </Window.Resources>
    
    <Grid RowDefinitions="30 *">
        <!--标题栏-->
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
            <CheckBox Content="绘制状态" Foreground="#00FFFF" IsChecked="{Binding IsDrawing, Mode=TwoWay}" Margin="0 0 20 0">
                <CheckBox.LayoutTransform>
                    <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                </CheckBox.LayoutTransform>
            </CheckBox>
            <CheckBox Style="{StaticResource WOpenChecxBox}" IsChecked="{Binding AutoSave,Mode=TwoWay}" Margin="20 0 0 0">
                <CheckBox.RenderTransform>
                    <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                </CheckBox.RenderTransform>
            </CheckBox>
            <TextBlock Text="自动保存" FontSize="18"  Foreground="#00FFFF" ></TextBlock>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200"  />
            </Grid.ColumnDefinitions>

            <Grid MinWidth="200" RowDefinitions="* auto *">
                <!-- 标签类别列表 -->
                <wcard:WCard
                    Title="标签列表"
                    TextColor="#00ccff"
                    Grid.Row="0"
                    Margin="4,0,4,4"
                    Background="#19FFFFFF"
                    Icon="Label"
                    IconColor="#00ccff">
                    <wcard:WCard.HeadControl>
                        <wiconbutton:IconButton Command="{Binding AddLabelTypeCommand}" IconSize="24" Icon="AddCircleOutline" Padding="0"/>
                    </wcard:WCard.HeadControl>

                    <ListBox Background="Transparent" BorderThickness="0"   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding LabelTypeItems}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border>
                                    <Grid ColumnDefinitions="auto auto">
                                        <material:MaterialIcon  Kind="Label" IconSize="30" Foreground="{Binding TypeId, Converter={StaticResource HashColorConvert}, ConverterParameter=1}"> 
                                          
                                        </material:MaterialIcon>
                                        <TextBox  BorderThickness="0" Text="{Binding TypeId}" Background="Transparent" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBox>
                                        <textedit:TextEdit
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="{Binding TypeName,Mode=TwoWay}" />
                                    </Grid>

                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </wcard:WCard>

                <GridSplitter
                    Grid.Row="1"
                    Height="4"
                    HorizontalAlignment="Stretch"
                    Background="Transparent" />

                <!--  图片列表  -->
                <wcard:WCard
                    Title="图片列表"
                    TextColor="#00ccff"
                    Grid.Row="2"
                    Margin="4,0,4,4"
                    Background="#19FFFFFF"
                    Icon="Image"
                    IconColor="#00ccff">
                    <wcard:WCard.HeadControl>
                        <wiconbutton:IconButton Padding="0"  IconSize="24" 
                            Command="{Binding AddImageCommand}"
                           Icon="AddCircleOutline"/>
                    </wcard:WCard.HeadControl>
                    <ListBox BorderThickness="0"
                        Background="Transparent"
                        ItemsSource="{Binding ImageLabelManagementService.ImageLabels}"
                        SelectedItem="{Binding SelectImage, Mode=TwoWay}">
                      
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Foreground="Red" Text="{Binding ImagePath, Converter={StaticResource FIlePathToFileNameConvert}}" />

                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>


                </wcard:WCard>


            </Grid>
            <GridSplitter
                Grid.Column="1"
                Width="4"
                VerticalAlignment="Stretch"
                Background="Transparent"
                ResizeBehavior="PreviousAndNext" />

            <!--  roi画布  -->
            <Border
                Grid.Column="2"
                Margin="4,4,4,4"
                Background="#2aFFFFFF">
                <Grid
                    x:Name="AdornerGrid"
                    Background="Transparent"
                    ClipToBounds="True"
                    MouseMove="AdornerGrid_MouseMove"
                    PreviewMouseWheel="AdornerGrid_PreviewMouseWheel">
                    <zoomimage:ZoomImage x:Name="myZoomImage" Source="{Binding SelectImage.ImagePath}" />
                    <ListBox
                        Background="{x:Null}"
                        BorderThickness="0"
                        ItemsSource="{Binding SelectImage.Labels}"
                        SelectedItem="{Binding SelectedLabel, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <rectroi:RectRoiControl
                                    x:Name="roi"
                                    RoiFill="{Binding TypeId, Converter={StaticResource HashColorConvert}, ConverterParameter=0.1}"
                                    ThumbColor="{Binding TypeId, Converter={StaticResource HashColorConvert}, ConverterParameter=1}">
                                    <rectroi:RectRoiControl.P1X>
                                        <MultiBinding Converter="{StaticResource point_convert}" ConverterParameter="X">
                                            <Binding ElementName="myZoomImage" Mode="OneWay" />
                                            <Binding
                                                ElementName="myZoomImage"
                                                Mode="OneWay"
                                                Path="OffsetX" />
                                            <Binding
                                                ElementName="myZoomImage"
                                                Mode="OneWay"
                                                Path="OffsetY" />
                                            <Binding
                                                ElementName="myZoomImage"
                                                Mode="OneWay"
                                                Path="ZoomRatio" />
                                            <Binding Path="Nx1" />
                                        </MultiBinding>
                                    </rectroi:RectRoiControl.P1X>
                                    <rectroi:RectRoiControl.P1Y>
                                        <MultiBinding Converter="{StaticResource point_convert}" ConverterParameter="Y">
                                            <Binding ElementName="myZoomImage" Mode="OneWay" />
                                            <Binding
                                                ElementName="myZoomImage"
                                                Mode="OneWay"
                                                Path="OffsetX" />
                                            <Binding
                                                ElementName="myZoomImage"
                                                Mode="OneWay"
                                                Path="OffsetY" />
                                            <Binding
                                                ElementName="myZoomImage"
                                                Mode="OneWay"
                                                Path="ZoomRatio" />
                                            <Binding Path="Ny1" />

                                        </MultiBinding>
                                    </rectroi:RectRoiControl.P1Y>
                                    <rectroi:RectRoiControl.P2X>
                                        <MultiBinding Converter="{StaticResource point_convert}" ConverterParameter="X">
                                            <Binding ElementName="myZoomImage" Mode="OneWay" />
                                            <Binding
                                                ElementName="myZoomImage"
                                                Mode="OneWay"
                                                Path="OffsetX" />
                                            <Binding
                                                ElementName="myZoomImage"
                                                Mode="OneWay"
                                                Path="OffsetY" />
                                            <Binding
                                                ElementName="myZoomImage"
                                                Mode="OneWay"
                                                Path="ZoomRatio" />
                                            <Binding Path="Nx2" />

                                        </MultiBinding>
                                    </rectroi:RectRoiControl.P2X>
                                    <rectroi:RectRoiControl.P2Y>
                                        <MultiBinding Converter="{StaticResource point_convert}" ConverterParameter="Y">
                                            <Binding ElementName="myZoomImage" Mode="OneWay" />
                                            <Binding
                                                ElementName="myZoomImage"
                                                Mode="OneWay"
                                                Path="OffsetX" />
                                            <Binding
                                                ElementName="myZoomImage"
                                                Mode="OneWay"
                                                Path="OffsetY" />
                                            <Binding
                                                ElementName="myZoomImage"
                                                Mode="OneWay"
                                                Path="ZoomRatio" />
                                            <Binding Path="Ny2" />

                                        </MultiBinding>
                                    </rectroi:RectRoiControl.P2Y>
                                </rectroi:RectRoiControl>
                                <!--  触发器  -->
                                <DataTemplate.Triggers>
                                    <!--  未选中时隐藏填充色  -->
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="false">
                                        <Setter TargetName="roi" Property="RoiFill" Value="Transparent" />
                                    </DataTrigger>

                                    <!--  鼠标悬浮时显示半透明填充  -->
                                    <Trigger SourceName="roi" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="roi" Property="RoiFill" Value="{Binding TypeId, Converter={StaticResource HashColorConvert}, ConverterParameter=0.2}" />
                                    </Trigger>

                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ItemsPresenter />
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <!--  当前绘画目标  -->
                    <rectroi:RectRoiControl RoiFill="#19FF0000" Visibility="{Binding IsDrawing,Converter={StaticResource BooleanToVisibilityConverter}}" ThumbColor="Red">
                        <rectroi:RectRoiControl.P1X>
                            <MultiBinding Converter="{StaticResource point_convert}" ConverterParameter="X">
                                <Binding ElementName="myZoomImage" Mode="OneWay" />
                                <Binding
                                    ElementName="myZoomImage"
                                    Mode="OneWay"
                                    Path="OffsetX" />
                                <Binding
                                    ElementName="myZoomImage"
                                    Mode="OneWay"
                                    Path="OffsetY" />
                                <Binding
                                    ElementName="myZoomImage"
                                    Mode="OneWay"
                                    Path="ZoomRatio" />
                                <Binding Path="DrawingPointX1_n" />
                            </MultiBinding>
                        </rectroi:RectRoiControl.P1X>
                        <rectroi:RectRoiControl.P1Y>
                            <MultiBinding Converter="{StaticResource point_convert}" ConverterParameter="Y">
                                <Binding ElementName="myZoomImage" Mode="OneWay" />
                                <Binding
                                    ElementName="myZoomImage"
                                    Mode="OneWay"
                                    Path="OffsetX" />
                                <Binding
                                    ElementName="myZoomImage"
                                    Mode="OneWay"
                                    Path="OffsetY" />
                                <Binding
                                    ElementName="myZoomImage"
                                    Mode="OneWay"
                                    Path="ZoomRatio" />
                                <Binding Path="DrawingPointY1_n" />

                            </MultiBinding>
                        </rectroi:RectRoiControl.P1Y>
                        <rectroi:RectRoiControl.P2X>
                            <MultiBinding Converter="{StaticResource point_convert}" ConverterParameter="X">
                                <Binding ElementName="myZoomImage" Mode="OneWay" />
                                <Binding
                                    ElementName="myZoomImage"
                                    Mode="OneWay"
                                    Path="OffsetX" />
                                <Binding
                                    ElementName="myZoomImage"
                                    Mode="OneWay"
                                    Path="OffsetY" />
                                <Binding
                                    ElementName="myZoomImage"
                                    Mode="OneWay"
                                    Path="ZoomRatio" />
                                <Binding Path="DrawingPointX2_n" />

                            </MultiBinding>
                        </rectroi:RectRoiControl.P2X>
                        <rectroi:RectRoiControl.P2Y>
                            <MultiBinding Converter="{StaticResource point_convert}" ConverterParameter="Y">
                                <Binding ElementName="myZoomImage" Mode="OneWay" />
                                <Binding
                                    ElementName="myZoomImage"
                                    Mode="OneWay"
                                    Path="OffsetX" />
                                <Binding
                                    ElementName="myZoomImage"
                                    Mode="OneWay"
                                    Path="OffsetY" />
                                <Binding
                                    ElementName="myZoomImage"
                                    Mode="OneWay"
                                    Path="ZoomRatio" />
                                <Binding Path="DrawingPointY2_n" />

                            </MultiBinding>
                        </rectroi:RectRoiControl.P2Y>
                    </rectroi:RectRoiControl>
                    <Border
                        Background="Transparent"
                        Cursor="Pen"
                        IsHitTestVisible="{Binding IsDrawing}"
                        MouseDown="Border_MouseDown"
                        MouseMove="Border_MouseMove"
                        MouseUp="Border_MouseUp" />
                </Grid>
            </Border>
            <GridSplitter
                Grid.Column="3"
                Width="4"
                VerticalAlignment="Stretch"
                Background="Transparent"
                ResizeBehavior="PreviousAndNext" />

            <!-- 已有标记列表 -->
            <wcard:WCard
                Title="标记列表"
                Grid.Column="4"
                MinWidth="200"
                 Margin="4,0,0,4"
                Icon="AspectRatio"
                IconColor="Red"
                TextColor="Red"
                Background="#19FFFFFF">
                <ListBox Background="Transparent" BorderThickness="0"  HorizontalContentAlignment="Stretch" ItemsSource="{Binding SelectImage.Labels}" SelectedItem="{Binding SelectedLabel, Mode=TwoWay}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto * Auto">
                                <material:MaterialIcon IconSize="24" Foreground="{Binding TypeId,Converter={StaticResource HashColorConvert}}">
                                    <material:MaterialIcon.Kind>
                                        <MultiBinding Converter="{StaticResource FindTypeIdConvert}" Mode="OneWay">
                                            <Binding Path="TypeId" />
                                            <Binding Path="DataContext.LabelTypeItems" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        </MultiBinding>
                                    </material:MaterialIcon.Kind>

                                </material:MaterialIcon>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Stretch"  VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LabelNameConvert}" Mode="OneWay">
                                            <Binding Path="TypeId" />
                                            <Binding Path="DataContext.LabelTypeItems" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <wiconbutton:IconButton
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    Command="{Binding DataContext.RemoveImageLabelCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Icon="DeleteForever"
                                    IconColor="Red"
                                    IconSize="24" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </wcard:WCard>

        </Grid>
    </Grid>
</Window>
