<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="WOpenChecxBox" TargetType="{x:Type CheckBox}">
        <!--  固定开关尺寸，确保滑块计算准确  -->
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid>
                        <!--  轨道：背景色随选中状态变化  -->
                        <Border x:Name="TrackBorder"
                                CornerRadius="15"
                                Background="#FFCCCCCC"
                                BorderBrush="#FFBBBBBB"
                                BorderThickness="1" />

                        <!--  圆形滑块：随选中状态左右移动  -->
                        <Ellipse x:Name="ThumbEllipse"
                                 Width="24" Height="24"
                                 Margin="3,0,0,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Fill="White">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="0" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4"
                                                  ShadowDepth="1"
                                                  Direction="270"
                                                  Opacity="0.3" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!--  选中：滑块滑到右侧，背景变绿  -->
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.25"
                                                         Storyboard.TargetName="ThumbEllipse"
                                                         Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.X)"
                                                         To="30">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Duration="0:0:0.25"
                                                        Storyboard.TargetName="TrackBorder"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#FF000099" />
                                        <ColorAnimation Duration="0:0:0.25"
                                                        Storyboard.TargetName="TrackBorder"
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="#FF000099" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <!--  取消选中：滑块回到左侧，背景变灰  -->
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.25"
                                                         Storyboard.TargetName="ThumbEllipse"
                                                         Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.X)"
                                                         To="0">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Duration="0:0:0.25"
                                                        Storyboard.TargetName="TrackBorder"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#FFCCCCCC" />
                                        <ColorAnimation Duration="0:0:0.25"
                                                        Storyboard.TargetName="TrackBorder"
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="#FFBBBBBB" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!--  鼠标悬停：轻微提亮  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TrackBorder" Property="Opacity" Value="0.85" />
                        </Trigger>

                        <!--  禁用：整体变淡  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>