<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Wlina.Components.RectRoiShape">

    <!--  RectRoiControl 控件模板  -->
    <Style TargetType="{x:Type local:RectRoiControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RectRoiControl}">
                    <Canvas>

                        <!--  矩形：直接绑定 P1X/P1Y/P2X/P2Y  -->
                        <local:RectRoiShape
                            Fill="Transparent"
                            Opacity="0.6"
                            P1X="{TemplateBinding P1X}"
                            P1Y="{TemplateBinding P1Y}"
                            P2X="{TemplateBinding P2X}"
                            P2Y="{TemplateBinding P2Y}" />

                        <!--
                            整体移动手柄：覆盖整个矩形区域
                            Width/Height 需在后台代码中计算设置：
                            MoveTracker.Width  = P2X - P1X
                            MoveTracker.Height = P2Y - P1Y
                            Canvas.Left = P1X, Canvas.Top = P1Y
                        -->
                        <Thumb
                            x:Name="MoveTracker"
                            Background="{TemplateBinding RoiFill}"
                            Cursor="SizeAll">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="{TemplateBinding Background}" Cursor="SizeAll" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>

                        <!--  四个角把手：原 Style 内容直接内联  -->

                        <!--  左上 ┐  -->
                        <Thumb
                            x:Name="LeftTopTracker"
                            Width="9"
                            Height="9"
                            Canvas.Left="{Binding P1X, RelativeSource={RelativeSource TemplatedParent}}"
                            Canvas.Top="{Binding P1Y, RelativeSource={RelativeSource TemplatedParent}}"
                            Cursor="SizeNWSE"
                            Stylus.IsPressAndHoldEnabled="false">
                            <Thumb.Template>
                                <ControlTemplate TargetType="{x:Type Thumb}">
                                    <Grid>
                                        <Rectangle Fill="Transparent">
                                            <Rectangle.RenderTransform>
                                                <TranslateTransform X="-5" Y="-5" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                        <Path Data="M0,0 L9,0 L9,2 L2,2 L2,9 L0,9 Z"  Fill="{Binding ThumbColor, RelativeSource={RelativeSource AncestorType={x:Type local:RectRoiControl}}}">
                                            <Path.RenderTransform>
                                                <TranslateTransform X="-2" Y="-2" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>

                        <!--  右上 └  -->
                        <Thumb
                            x:Name="RightTopTracker"
                            Width="9"
                            Height="9"
                            Canvas.Left="{Binding P2X, RelativeSource={RelativeSource TemplatedParent}}"
                            Canvas.Top="{Binding P1Y, RelativeSource={RelativeSource TemplatedParent}}"
                            Cursor="SizeNESW"
                            Stylus.IsPressAndHoldEnabled="false">
                            <Thumb.Template>
                                <ControlTemplate TargetType="{x:Type Thumb}">
                                    <Grid>
                                        <Rectangle Fill="Transparent">
                                            <Rectangle.RenderTransform>
                                                <TranslateTransform X="-4" Y="-5" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                        <Path Data="M0,0 L9,0 L9,9 L7,9 L7,2 L0,2 Z"  Fill="{Binding ThumbColor, RelativeSource={RelativeSource AncestorType={x:Type local:RectRoiControl}}}">
                                            <Path.RenderTransform>
                                                <TranslateTransform X="-7" Y="-2" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>

                        <!--  左下 ┘  -->
                        <Thumb
                            x:Name="LeftBottomTracker"
                            Width="9"
                            Height="9"
                            Canvas.Left="{Binding P1X, RelativeSource={RelativeSource TemplatedParent}}"
                            Canvas.Top="{Binding P2Y, RelativeSource={RelativeSource TemplatedParent}}"
                            Cursor="SizeNESW"
                            Stylus.IsPressAndHoldEnabled="false">
                            <Thumb.Template>
                                <ControlTemplate TargetType="{x:Type Thumb}">
                                    <Grid>
                                        <Rectangle Fill="Transparent">
                                            <Rectangle.RenderTransform>
                                                <TranslateTransform X="-5" Y="-4" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                        <Path Data="M0,0 L2,0 L2,7 L9,7 L9,9 L0,9 Z" Fill="{Binding ThumbColor, RelativeSource={RelativeSource AncestorType={x:Type local:RectRoiControl}}}">
                                            <Path.RenderTransform>
                                                <TranslateTransform X="-2" Y="-7" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>

                        <!--  右下 ┌  -->
                        <Thumb
                            x:Name="RightBottomTracker"
                            Width="9"
                            Height="9"
                            Canvas.Left="{Binding P2X, RelativeSource={RelativeSource TemplatedParent}}"
                            Canvas.Top="{Binding P2Y, RelativeSource={RelativeSource TemplatedParent}}"
                            Cursor="SizeNWSE"
                            Stylus.IsPressAndHoldEnabled="false">
                            <Thumb.Template>
                                <ControlTemplate TargetType="{x:Type Thumb}">
                                    <Grid>
                                        <Rectangle Fill="Transparent">
                                            <Rectangle.RenderTransform>
                                                <TranslateTransform X="-4" Y="-4" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                        <Path Data="M7,0 L9,0 L9,9 L0,9 L0,7 L7,7 Z" Fill="{Binding ThumbColor, RelativeSource={RelativeSource AncestorType={x:Type local:RectRoiControl}}}">
                                            <Path.RenderTransform>
                                                <TranslateTransform X="-7" Y="-7" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>

                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>