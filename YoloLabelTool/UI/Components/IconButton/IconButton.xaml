<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Wlina.Components.IconButton"
    xmlns:material="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF">
    <Style TargetType="{x:Type local:IconButton}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IconColor" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:IconButton}">
                    <Grid>
                        <Border
                            x:Name="BtnBorder"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="{Binding Path=Radius, RelativeSource={RelativeSource TemplatedParent}}" />
                        <StackPanel
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <material:MaterialIcon
                                x:Name="LeftIcon"
                                Width="{Binding Path=IconSize, RelativeSource={RelativeSource TemplatedParent}}"
                                Height="{Binding Path=IconSize, RelativeSource={RelativeSource TemplatedParent}}"
                                Margin="2,2"
                                Foreground="{Binding Path=IconColor, RelativeSource={RelativeSource TemplatedParent}}"
                                Kind="{Binding Path=Icon, RelativeSource={RelativeSource TemplatedParent}}"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="RightText"
                                Width="Auto"
                                Margin="2,2"
                                VerticalAlignment="Center"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{Binding Path=TextColor, RelativeSource={RelativeSource TemplatedParent}}"
                                Text="{TemplateBinding Text}"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasIcon" Value="True">
                            <Setter TargetName="LeftIcon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasText" Value="True">
                            <Setter TargetName="RightText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!--  问题2修复：删除无效的 IsMouseOver=False 触发器，补上真实悬停/按下反馈  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#22FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#3DFFFFFF" />
                        </Trigger>
                        <!--  问题3（禁用状态）本轮未要求，预留占位：
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                        -->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>