<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Wlina.Components.TextEdit"
                    >

    <Style TargetType="{x:Type local:TextEdit}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TextEdit}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <TextBlock x:Name="PART_TextBlock"
                                       Background="Transparent"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{Binding FontSize, Mode=TwoWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:TextEdit}}"
                                       Text="{Binding Text, Mode=TwoWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:TextEdit}}" />
                            <TextBox x:Name="PART_TextBox"
                                     Margin="-2,0,0,0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Visibility="Collapsed"
                                     Foreground="{TemplateBinding Foreground}"
                                     FontSize="{Binding FontSize, Mode=TwoWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:TextEdit}}"
                                     Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:TextEdit}}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>