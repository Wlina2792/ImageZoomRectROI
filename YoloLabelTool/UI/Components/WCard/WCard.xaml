<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Wlina.Components.WCard"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF">


    <Style TargetType="{x:Type local:WCard}">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#E0E0E0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:WCard}">
                    <!--  1. 卡片的外层边框与背景  -->
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">

                        <Grid Margin="4,4" RowDefinitions="Auto Auto *">

                            <!--  2. 头部区域布局  -->
                            <Grid
                                Grid.Row="0"
                                Margin="0,0,0,0"
                                ColumnDefinitions="Auto * Auto">
                                <!--  绑定 Icon 和 IconSize  -->
                                <materialIcons:MaterialIcon
                                    Width="{Binding Path=IconSize, RelativeSource={RelativeSource TemplatedParent}}"
                                    Height="{Binding Path=IconSize, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Foreground="{Binding Path=IconColor, RelativeSource={RelativeSource TemplatedParent}}"
                                    Kind="{Binding Path=Icon, RelativeSource={RelativeSource TemplatedParent}}" />

                                <!--  绑定 TitleText 和 TextSize, TextColor  -->
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="{Binding Path=TextSize, RelativeSource={RelativeSource TemplatedParent}}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    Foreground="{Binding Path=TextColor, RelativeSource={RelativeSource TemplatedParent}}"
                                    Text="{Binding Path=Title, RelativeSource={RelativeSource TemplatedParent}}" />

                                <!--  3. 绑定自定义的 HeadControl (例如右侧的按钮)  -->
                                <ContentPresenter
                                    Grid.Column="2"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Content="{Binding Path=HeadControl, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid>

                            <Line
                                Grid.Row="1"
                                Stretch="Fill"
                                Stroke="{Binding Path=IconColor, RelativeSource={RelativeSource TemplatedParent}}"
                                StrokeThickness="1"
                                X1="0"
                                X2="1"
                                Y1="0"
                                Y2="0" />
                            <!-- 4. 核心：显示 <local:WCard> 标签内嵌套的子内容 -->
                            <ContentPresenter Grid.Row="2" Content="{TemplateBinding Content}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>